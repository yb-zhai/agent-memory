# DSH-memory-nebula 环境变量示例（复制为 .env 按需填入；插件自身不存储任何密钥）
#
# 注意：这些变量由启动脚本 / index.js 挂载进 server.js 进程。
# 前缀统一为 MEMORY_NEBULA_*，避免与旧的 BRAIN_NEBULA_* / HINDSIGHT_URL 混用。

# —— 面板 ——
# 面板端口（默认 8898；被占用自动退到 8898–8910）
MEMORY_NEBULA_PORT=8898

# —— 本地记忆引擎（零依赖，默认）——
# 本地 JSONL 数据目录（默认 %DSH_HOME%/memory-nebula-data，或 ~/.memory-nebula）
MEMORY_NEBULA_DATA_DIR=

# —— Hindsight 可选叠加层 ——
# Hindsight HTTP API 地址（默认 http://127.0.0.1:8888；留空或设 disable 则完全禁用叠加，降级纯单机）
MEMORY_NEBULA_HINDSIGHT_URL=http://127.0.0.1:8888
# Hindsight 根目录（worker-window.json / worker-window.ps1 / cost-guard.state.json 都从它派生）
# 安装到 DSH 时，安装器自动写入 %DSH_HOME%\hindsight；直接运行源码时留空即显示「未知」
MEMORY_NEBULA_HINDSIGHT_DIR=
# 指定 bank（留空自动选：优先 coding-agent::<DSH_PROFILE>，否则取记忆最多的 bank）
MEMORY_NEBULA_BANK=
# Hindsight API key（可选；经 Authorization: Bearer 带入。插件不落盘、不写回任何文件）
MEMORY_NEBULA_HINDSIGHT_KEY=
# 设 1 强制禁用 Hindsight 叠加（即便 URL 可达也只跑单机）
MEMORY_NEBULA_DISABLE_HINDSIGHT=

# —— 调优（一般不用改）——
# 星图规模（全功能面板默认每类 1500 节点、边上限 12000；轻量场景可调小）
MEMORY_NEBULA_GRAPH_NODES=1500
MEMORY_NEBULA_MAX_EDGES=12000
MEMORY_NEBULA_REFRESH_MS=1500
MEMORY_NEBULA_GRAPH_REFRESH_MS=60000
MEMORY_NEBULA_REQUEST_TIMEOUT_MS=8000

# 权限说明：
#   - MEMORY_NEBULA_HINDSIGHT_KEY 仅由你在运行时通过环境变量注入，插件绝不把它写入磁盘、日志或导出文件；
#   - 面板服务只监听 127.0.0.1，不对外网开放；
#   - 本地 JSONL 数据写在你指定的 MEMORY_NEBULA_DATA_DIR（默认在 %DSH_HOME% 下），不联网、不上传。
