{
    "name": "dsh-memory-nebula",
    "version": "1.4.0",
    "private": true,
    "type": "module",
    "description": "DSH memory nebula — a self-contained memory panel + zero-dependency local memory engine (NebulaMemory JSONL), with optional Hindsight HTTP API overlay. Packable standalone, installable into any DSH.",
    "icon": "icon.svg",
    "main": "index.js",
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./server": "./server.js",
        "./package.json": "./package.json"
    },
    "files": [
        "index.js",
        "client.js",
        "server.js",
        "lib/",
        "memory/",
        "shared/",
        "scripts/",
        "panel.html",
        "cordis.patch.yml",
        "icon.svg",
        "config.example.json",
        ".env.example",
        "README.md",
        "LICENSE",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "install.ps1",
        "install.cmd",
        "uninstall.ps1",
        "uninstall.cmd"
    ],
    "scripts": {
        "start": "node server.js",
        "release": "release-it",
        "release:dry": "release-it --dry-run",
        "release:patch": "release-it patch",
        "release:minor": "release-it minor",
        "release:major": "release-it major",
        "release:pre": "release-it --preRelease=beta",
        "release:rc": "release-it --preRelease=rc",
        "changelog": "release-it --changelog"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-client-ui-layout",
                "@deepseek-ai/dsh-client-ui-sidebar"
            ]
        }
    },
    "devDependencies": {
        "@release-it/conventional-changelog": "^12.0.2",
        "release-it": "^21.1.3"
    }
}
