{
    "name":  "dsh-memory-nebula",
    "version": "1.3.13",
    "private":  true,
    "type":  "module",
    "description":  "DSH memory nebula — a self-contained memory panel + zero-dependency local memory engine (NebulaMemory JSONL), with optional Hindsight HTTP API overlay. Packable standalone, installable into any DSH.",
    "icon":  "icon.svg",
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./server":  "./server.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "server.js",
                  "lib/",
                  "memory/",
                  "shared/",
                  "scripts/",
                  "panel.html",
                  "cordis.patch.yml",
                  "icon.svg",
                  "config.example.json",
                  ".env.example",
                  "README.md",
                  "LICENSE",
                  "CONTRIBUTING.md",
                  "SECURITY.md",
                  "install.ps1",
                  "install.cmd",
                  "uninstall.ps1",
                  "uninstall.cmd"
              ],
    "scripts":  {
                    "start":  "node server.js"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-layout",
                                              "@deepseek-ai/dsh-client-ui-sidebar"
                                          ]
                           }
            }
}